#!/usr/bin/env python

Import("env")

arch = env.get("arch", "x86_64")
print("🔧 [SCsub] Building SBC platform for architecture:", arch)

# ========== Glad include paths ==========
thirdparty_dir = "#thirdparty/glad/"
env.Prepend(CPPPATH=[thirdparty_dir + "/glad/"])
env.Prepend(CPPPATH=[thirdparty_dir])

# ========== SDL2 configuration ==========
import os

sdl_header_path = "/usr/include/SDL2/SDL.h"

if arch == "arm64":
    # ✅ Manual SDL2 include/lib path for ARM64 (cross-compiling)
    if not os.path.exists(sdl_header_path):
        print("❌ Error: SDL2 header not found at", sdl_header_path)
        Exit(1)
    else:
        print("✅ SDL2 header found.")

    env.Append(CPPPATH=["/usr/include/SDL2"])
    env.Append(LIBS=["SDL2"])

else:
    # ✅ Use pkg-config for native x86_64 builds
    try:
        env.ParseConfig("pkg-config --cflags --libs sdl2")
    except Exception as e:
        print("⚠️ Warning: Failed to parse SDL2 pkg-config.")
        print(e)
        Exit(1)

# ========== SBC source files ==========
sbc_sources = [
    "os_sbc.cpp",
    "display_server_sdl.cpp",
    "audio_driver_sbc.cpp",
    "rendering_context_driver_vulkan_sdl.cpp",
]

# ========== Build the binary ==========
prog = env.add_program("#bin/godot", ["godot_sbc.cpp"] + sbc_sources)
